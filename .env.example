# Anthropic fork: Play Asset Delivery / Brotli / delta patching pipeline
#
# These are additive to Zealot's normal configuration. See config.env for
# the full list of standard Zealot environment variables.

BUNDLETOOL_PATH=/usr/local/bin/bundletool
BROTLI_PATH=/usr/bin/brotli
BSDIFF_PATH=/usr/bin/bsdiff
BSPATCH_PATH=/usr/bin/bspatch
BROTLI_QUALITY=11
ENABLE_DELTA_PATCHING=true
ENABLE_ASSET_PACK_DELIVERY=true

# ReleaseStorage adapter for pipeline artifacts (compressed APK sets, delta
# patches, asset pack splits). "local" (default outside production) needs no
# further config; in production leaving this unset is an error, because hosts
# like Render lose local disk on every deploy. "r2" requires the R2_* vars
# below; "github" requires the GITHUB_STORAGE_* vars.
RELEASE_STORAGE_ADAPTER=local

# Cloudflare R2 (S3-compatible) — only required when RELEASE_STORAGE_ADAPTER=r2
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# GitHub Releases as storage (Task 19) — only required when
# RELEASE_STORAGE_ADAPTER=github. Use a dedicated, PRIVATE repo that is not
# this code repo. The token is fine-grained, scoped to that one repo, with
# "Contents: read and write". Both are secrets: set them in the host's
# dashboard, never commit real values.
GITHUB_STORAGE_REPO=
GITHUB_STORAGE_TOKEN=
# Refuses a public storage repo unless this is "true" (anyone could download
# every stored build from a public repo).
GITHUB_STORAGE_ALLOW_PUBLIC=
# Default https://api.github.com (only change for GitHub Enterprise)
GITHUB_API_URL=

# Task 16: Novu as the delivery layer for the automated emails (deploy, campaign,
# notice). While NOVU_API_KEY is empty the emails go out over SMTP as before.
# NOVU_API_KEY is the environment's *Secret Key* (Novu dashboard -> API Keys).
NOVU_API_KEY=
# Default https://api.novu.co  (EU region: https://eu.api.novu.co; or your self-hosted API URL)
NOVU_API_URL=
# Force one provider: smtp | novu. Unset = novu when NOVU_API_KEY is set, else smtp.
# `smtp` is the rollback switch if Novu misbehaves.
ZEALOT_EMAIL_PROVIDER=

# Task 32: B-PAY (the operator's self-hosted Hyperswitch instance) — the
# storefront listing fee ($14.99 one-time) + recurring maintenance fee
# ($2/mo, $9.99/6mo, custom annual). See HyperswitchClient and
# HyperswitchWebhooksController.
# The *secret* key from Control Center -> Developer -> API Keys (not the
# publishable/hash key — that's a client-side SDK concern, unused here).
HYPERSWITCH_API_KEY=
# Confirmed live: https://b-pay-backend-new.onrender.com
HYPERSWITCH_API_URL=https://b-pay-backend-new.onrender.com
# Shared secret for verifying inbound webhook signatures. Header name is
# configurable because B-PAY's actual signing header was not confirmed yet
# — see the ⚠️ comment atop HyperswitchWebhooksController before relying
# on this in production.
HYPERSWITCH_WEBHOOK_SECRET=
HYPERSWITCH_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Trigger identifiers of the three Novu workflows (defaults shown)
NOVU_WORKFLOW_RELEASE_DEPLOYED=zealot-release-deployed
NOVU_WORKFLOW_NOTICE=zealot-notice
NOVU_WORKFLOW_CAMPAIGN=zealot-campaign
