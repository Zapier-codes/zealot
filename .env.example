# Anthropic fork: Play Asset Delivery / Brotli / delta patching pipeline
#
# These are additive to Zealot's normal configuration. See config.env for
# the full list of standard Zealot environment variables.

BUNDLETOOL_PATH=/usr/local/bin/bundletool
BROTLI_PATH=/usr/bin/brotli
BSDIFF_PATH=/usr/bin/bsdiff
BSPATCH_PATH=/usr/bin/bspatch
BROTLI_QUALITY=11
ENABLE_DELTA_PATCHING=true
ENABLE_ASSET_PACK_DELIVERY=true

# ReleaseStorage adapter for pipeline artifacts (compressed APK sets, delta
# patches, asset pack splits). "local" (default outside production) needs no
# further config; in production leaving this unset is an error, because hosts
# like Render lose local disk on every deploy. "r2" requires the R2_* vars
# below; "github" requires the GITHUB_STORAGE_* vars.
RELEASE_STORAGE_ADAPTER=local

# Cloudflare R2 (S3-compatible) — only required when RELEASE_STORAGE_ADAPTER=r2
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Task 40h: Cloudflare R2 staging bucket for direct uploads. The client sends the file straight to this
# bucket through a presigned URL, so Render never receives the bytes; CI reads it and moves it into the
# storage repo. NOT the same bucket or token as the R2_* block above (that one is the storage adapter).
# The token needs only presign, HEAD and delete on this one bucket (R2 "Object Read & Write", scoped to it).
# Used by ReleaseUploadStaging; nothing calls it until the upload session slice (40h-b). Secrets: set them in
# the host's dashboard, never commit real values.
R2_STAGING_BUCKET=
R2_STAGING_ENDPOINT=
R2_STAGING_ACCESS_KEY_ID=
R2_STAGING_SECRET_ACCESS_KEY=
R2_STAGING_REGION=auto
# Task 40h-b: opens the direct-to-storage upload doors (console and API). Off unless exactly "true" AND the four
# R2_STAGING_* variables above are set; until then both doors answer 404. Finalize stops at `uploaded` until 40i-a.
RELEASE_UPLOAD_SESSIONS_ENABLED=

# GitHub Releases as storage (Task 19) — only required when
# RELEASE_STORAGE_ADAPTER=github. Use a dedicated, PRIVATE repo that is not
# this code repo. The token is fine-grained, scoped to that one repo, with
# "Contents: read and write". Both are secrets: set them in the host's
# dashboard, never commit real values.
GITHUB_STORAGE_REPO=
GITHUB_STORAGE_TOKEN=
# Refuses a public storage repo unless this is "true" (anyone could download
# every stored build from a public repo).
GITHUB_STORAGE_ALLOW_PUBLIC=
# Default https://api.github.com (only change for GitHub Enterprise)
GITHUB_API_URL=

# Task 40: Zealot stops compiling release files itself; the storage repo's GitHub Actions workflow does it
# and calls back. Requires RELEASE_STORAGE_ADAPTER=github. Off unless CI_COMPILE_ENABLED is exactly "true".
CI_COMPILE_ENABLED=
# Fine-grained token for the storage repo with "Actions: read and write" (a different token from
# GITHUB_STORAGE_TOKEN, which only needs Contents). Secret.
CI_COMPILE_DISPATCH_TOKEN=
# Shared secret the workflow sends back to /api/ci_compile/:id/callback. Secret. Unset = every callback refused.
CI_COMPILE_CALLBACK_TOKEN=
# Optional: repo holding the workflow (default GITHUB_STORAGE_REPO), workflow file (default compile-aab.yml),
# branch it runs from (default main), and the signing certificate SHA-256 CI must report (off when empty).
CI_COMPILE_REPO=
CI_COMPILE_WORKFLOW=
CI_COMPILE_REF=
CI_COMPILE_EXPECT_CERT_SHA256=
# Task 40g: minutes a release may stay queued or dispatched with no result before the sweeper (every 15 minutes)
# marks it failed. Default 90 (the workflow's own timeout is 45).
CI_COMPILE_STALE_AFTER_MINUTES=

# Task 40g-2: minutes a finalized direct upload may stay `uploaded` with nothing processing it before the sweeper
# (every 15 minutes) marks it failed. Default 90.
RELEASE_UPLOAD_STALE_AFTER_MINUTES=

# Task 16: Novu as the delivery layer for the automated emails (deploy, campaign,
# notice). While NOVU_API_KEY is empty the emails go out over SMTP as before.
# NOVU_API_KEY is the environment's *Secret Key* (Novu dashboard -> API Keys).
NOVU_API_KEY=
# Default https://api.novu.co  (EU region: https://eu.api.novu.co; or your self-hosted API URL)
NOVU_API_URL=
# Force one provider: smtp | novu. Unset = novu when NOVU_API_KEY is set, else smtp.
# `smtp` is the rollback switch if Novu misbehaves.
ZEALOT_EMAIL_PROVIDER=

# Task 32: B-PAY (the operator's self-hosted Hyperswitch instance) — the
# storefront listing fee ($14.99 one-time) + recurring maintenance fee
# ($2/mo, $9.99/6mo, custom annual). See HyperswitchClient and
# HyperswitchWebhooksController.
# The *secret* key from Control Center -> Developer -> API Keys (not the
# publishable/hash key — that's a client-side SDK concern, unused here).
HYPERSWITCH_API_KEY=
# Confirmed live: https://b-pay-backend-new.onrender.com
HYPERSWITCH_API_URL=https://b-pay-backend-new.onrender.com
# Shared secret for verifying inbound webhook signatures. Header name is
# configurable because B-PAY's actual signing header was not confirmed yet
# — see the ⚠️ comment atop HyperswitchWebhooksController before relying
# on this in production.
HYPERSWITCH_WEBHOOK_SECRET=
HYPERSWITCH_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
# Client-side checkout (Unified Checkout embed, app/views/apps/store_listings/pay.html.slim):
# the *publishable* key from Control Center -> Developer -> API Keys (safe
# to expose in rendered HTML — not the secret key above).
HYPERSWITCH_PUBLISHABLE_KEY=
# Self-hosted Hyperswitch serves HyperLoader.js from a separately deployed
# "web client" component, not from the API host above. Host only, no
# scheme/path, e.g. web-client.example.com — the view builds
# https://<value>/HyperLoader.js. Leave blank until that component is
# deployed; the pay page shows a clear "not configured" message rather
# than a broken embed when it's empty.
HYPERSWITCH_SDK_URL=

# Trigger identifiers of the three Novu workflows (defaults shown)
NOVU_WORKFLOW_RELEASE_DEPLOYED=zealot-release-deployed
NOVU_WORKFLOW_NOTICE=zealot-notice
NOVU_WORKFLOW_CAMPAIGN=zealot-campaign
