ruby:
  schemes ||= 0
  channels ||= 0

ruby:
  # Task 20a: only the new/create submission should break out of the
  # #modal turbo frame (so a successful create's redirect_to @app does a
  # real top-level navigation to the new app's page, matching Play
  # Console's "land on the new app" behaviour). Edit/update keeps the
  # default frame-scoped target — it already relies on its own
  # update.turbo_stream response, which isn't frame-scoped anyway, and
  # leaving it as-is keeps this slice to one behaviour.
  form_data = { action: 'turbo:submit-end->modal#close' }
  form_data[:turbo_frame] = '_top' if new_or_create_route?

= simple_form_for app, data: form_data do |f|
  = f.error_notification

  = f.input :name, required: true
  / Task 18: the applicationId Play will fix from the first uploaded
  / bundle. Not a Play Console "create app" field — it is verified
  / against every Play-targeted AAB and adopted from the first one
  / when left blank. Shown on create and edit.
  = f.input :play_package_name, required: false, input_html: { placeholder: 'com.example.app' }
  / Task 24: the name store visitors see as "Published by". Only shown to
  / people AppPolicy#set_publisher_alias? allows (admin-only until company
  / verification exists); the controller enforces it too.
  - if policy(app).set_publisher_alias?
    = f.input :publisher_alias, required: false, input_html: { maxlength: App::PUBLISHER_ALIAS_MAX_LENGTH }
  / Category: mirrors Play Console's own "App category" picker exactly --
  / pick an application type (Apps/Games), then one category from that
  / type's list -- see App::APP_CATEGORIES/App::GAME_CATEGORIES and
  / catalog_index_v2.md's "Category vocabulary" section (❓1, resolved).
  / No policy gate, unlike publisher_alias above: any collaborator who can
  / edit this app can set its category, same as name/play_package_name.
  = f.input :category, as: :grouped_select, required: false, include_blank: true, \
    collection: [ [ 'Apps', App::APP_CATEGORIES ], [ 'Games', App::GAME_CATEGORIES ] ], \
    group_method: :last, group_label_method: :first
  - if new_or_create_route?
    = f.simple_fields_for :scheme_attributes do |n|
      = n.input :name, as: :check_boxes, collection: preset_schemes, checked: schemes, required: false
    = f.simple_fields_for :channel_attributes do |n|
      = n.input :name, as: :check_boxes, collection: preset_channels, checked: channels, required: false
  - else
    / Task #7: which Play Console track this App's approved releases
    / publish to. Only shown once the App already exists — a brand
    / new App has no Play Console listing yet (handover.md: first
    / listing is manual), so there's nothing for this to mean until
    / then.
    = f.input :play_publish_track, collection: %w[internal alpha beta production], \
      include_blank: false, label: t('simple_form.labels.app.play_publish_track'), \
      hint: t('simple_form.hints.app.play_publish_track')
    - if app.play_package_name.present? && app.play_setup_message.present?
      p.small.text-muted = app.play_setup_message
  .card-footer
    = f.button :submit
