- steps = app.setup_checklist_steps
- ordered_keys = %i[name first_upload package_id published]
- next_key = ordered_keys.find { |key| !steps[key] }
- done_count = steps.values.count(true)
- percent = steps.empty? ? 0 : (done_count * 100.0 / steps.size).round

.d-card.d-card-border.mb-4.setup-checklist
  .d-card-body.py-4
    .flex.items-center.justify-between.mb-2
      h3.d-card-title.text-base = t('apps.show.setup_checklist.title')
      span.text-xs.opacity-60 = t('apps.show.setup_checklist.progress', done: done_count, total: steps.size)
    progress.d-progress.d-progress-primary.mb-3 value=percent max="100"
    - if steps[:first_upload]
      .d-alert.d-alert-success.d-alert-soft.mb-3.text-sm
        = t('apps.show.setup_checklist.internal_live')
    ul.d-steps.d-steps-vertical
      - ordered_keys.each do |key|
        - done = steps[key]
        - if key == :package_id
          li.d-step.opacity-50.pointer-events-none
            span.text-xs.uppercase.tracking-wide = t('apps.show.setup_checklist.play_section')
        li class="d-step #{'d-step-primary' if done} #{'font-semibold' if key == next_key}"
          span = t("apps.show.setup_checklist.steps.#{key}")
          - if key == next_key
            span.d-badge.d-badge-sm.d-badge-primary.ml-2 = t('apps.show.setup_checklist.next')
          / Task 22: the upload page (releases#new) is only reachable from a
          / channel, and this checklist's own "Upload your first build" step used
          / to have no way there at all. Lead the user to whichever piece is
          / missing: upload page -> add a channel -> add a scheme. Links sit in
          / the #app turbo frame, so the upload link must target _top.
          - if key == :first_upload && !done && current_user&.manage?(app: app) && !app.archived
            - upload_channel = app.first_upload_channel
            - if upload_channel
              = link_to t('apps.show.setup_checklist.upload_build'), new_channel_release_path(upload_channel), \
                class: 'd-link d-link-primary text-xs ml-2', data: { turbo_frame: '_top' }
            - elsif app.schemes.none?
              = link_to t('apps.show.setup_checklist.add_scheme'), new_app_scheme_path(app), \
                class: 'd-link d-link-primary text-xs ml-2', data: { turbo_frame: :modal }
            - else
              = link_to t('apps.show.setup_checklist.add_channel'), new_app_scheme_channel_path(app, app.schemes.first), \
                class: 'd-link d-link-primary text-xs ml-2', data: { turbo_frame: :modal }
          - if key == :package_id && !done && current_user&.manage?(app: app)
            = link_to t('apps.show.setup_checklist.edit_package_id'), edit_app_path(app), \
              class: 'd-link d-link-primary text-xs ml-2', data: { turbo_frame: :modal }
          - if key == :published && !done && steps[:first_upload] && current_user&.admin?
            = link_to t('apps.show.setup_checklist.review_approvals'), admin_play_approvals_path, \
              class: 'd-link d-link-primary text-xs ml-2'
