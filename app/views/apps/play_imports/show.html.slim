/ Z-P25 §2: "Import from Play". GET reads the app's existing Play listing (Anthropic::PlayImportService) and
/ shows it; POST stages the fields into the app's one draft through ListingEditService. Nothing is written to
/ the live listing here and nothing is sent back to Play -- publishing happens on the store listing text
/ editor, exactly as if the owner had typed it. Forms target _top because the flash notice is outside any
/ turbo frame.
- content_for :title do
  = @title

- content_for :section_title do
  = @title
  small class="pl-2 text-sm"
    = @app.name

.row
  .col-md-12
    .card
      .card-header
        h3.card-title = t('.card_title')
      .card-body class="space-y-4"
        p.text-sm.opacity-70 = t('.intro')

        - if @result.ok?
          - if @listing.nil?
            .d-alert.d-alert-info role="status"
              span = t('.no_listing')
          - else
            p.text-xs.opacity-65 = t('.read_from', package: @result.package_name, language: @listing.language)

            - if @result.listings.size > 1
              p.text-xs.opacity-65 = t('.other_languages', languages: @result.listings.map(&:language).join(', '))

            table.table.table-sm
              thead
                tr
                  th = t('.play_field')
                  th = t('.play_value')
              tbody
                - Apps::PlayImportsController::IMPORTABLE.each do |field, play_key|
                  tr
                    td = t(".fields.#{field}")
                    td class="whitespace-pre-line" = @listing.public_send(play_key).presence || t('.empty')

            = form_with url: app_play_import_path(@app), method: :post, \
              html: { class: 'space-y-3' }, data: { turbo_frame: '_top' } do
              = hidden_field_tag :locale, @listing.language
              p.text-sm.opacity-70 = t('.stage_hint', fields: Apps::PlayImportsController::IMPORTABLE.keys.map { |f| t(".fields.#{f}") }.to_sentence)
              div class="flex flex-wrap items-center gap-3"
                = submit_tag t('.stage'), class: 'd-btn d-btn-primary'
                = link_to t('.back'), app_path(@app), class: 'd-link', data: { turbo_frame: '_top' }

            - if @app.play_package_name.blank?
              p.text-xs.opacity-65 = t('.adopt_package', package: @result.package_name)

          - if @tracks.any?
            .border-t.border-base-300.pt-4.space-y-2
              h4.text-sm.font-semibold = t('.tracks_title')
              p.text-xs.opacity-65 = t('.tracks_note')
              table.table.table-sm
                thead
                  tr
                    th = t('.track')
                    th = t('.track_status')
                    th = t('.track_versions')
                tbody
                  - @tracks.each do |track|
                    tr
                      td = track.track
                      td = track.status.presence || t('.empty')
                      td = track.version_codes.join(', ').presence || t('.empty')
        - else
          .d-alert.d-alert-warning role="alert"
            span = @result.message
          div class="flex flex-wrap items-center gap-3"
            = link_to t('.back'), app_path(@app), class: 'd-link', data: { turbo_frame: '_top' }

.row
  .col-md-12
    .card
      .card-header
        h3.card-title = t('.reviews_title')
      .card-body class="space-y-3"
        p.text-sm.opacity-70 = t('.reviews_intro')
        - if @reviews_result.ok? && @reviews_result.reviews.any?
          p.text-xs.opacity-65 = t('.reviews_count', count: @reviews_result.reviews.size)
          .space-y-3
            - @reviews_result.reviews.each do |review|
              .border-b.border-base-300.pb-3
                div class="flex flex-wrap items-center gap-2"
                  span.font-semibold = review.author_name.presence || t('.anonymous')
                  span.text-xs.opacity-65 = t('.rating', count: review.rating) if review.rating
                  span.text-xs.opacity-65 = review.last_modified if review.last_modified
                  - if review.app_version_name.present?
                    span.text-xs.opacity-65 = review.app_version_name
                p.text-sm class="whitespace-pre-line" = review.text.presence || t('.no_text')
                - if review.developer_reply.present?
                  .mt-2.pl-3.border-l-2.border-primary
                    p.text-xs.opacity-70 = t('.developer_reply', when: review.replied_at)
                    p.text-sm class="whitespace-pre-line" = review.developer_reply
        - elsif @reviews_result.ok?
          .d-alert.d-alert-info role="status"
            span = t('.no_reviews')
        - else
          .d-alert.d-alert-warning role="alert"
            span = @reviews_result.message

.row
  .col-md-12
    .card
      .card-header
        h3.card-title = t('.vitals_title')
      .card-body class="space-y-3"
        p.text-sm.opacity-70 = t('.vitals_intro', days: Anthropic::PlayImportService::VITALS_WINDOW_DAYS)
        - if @vitals_result.ok? && @vitals_result.vitals.any?
          table.table.table-sm
            thead
              tr
                th = t('.vitals_metric')
                th = t('.vitals_latest')
                th = t('.vitals_users')
            tbody
              - [ @vitals_result.crash, @vitals_result.anr ].each do |series|
                - next if series.nil?
                - latest = series.value
                tr
                  td = t(".vitals_kinds.#{series.kind}")
                  td = latest.nil? ? t('.not_measured') : t('.vitals_percent', value: latest)
                  td = series.user_count.nil? ? t('.empty') : number_with_delimiter(series.user_count)
        - elsif @vitals_result.ok?
          .d-alert.d-alert-info role="status"
            span = t('.no_vitals')
        - else
          .d-alert.d-alert-warning role="alert"
            span = @vitals_result.message
