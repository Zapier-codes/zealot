- content_for :title do
  = @app.name

- content_for :section_title do
  = turbo_frame_tag @app do
    = @app.name
    - if @app.archived
      small class="d-badge d-badge-sm d-badge-warning py-1 ms-2"
        = t('apps.show.archived')
    / Task 25: store listing state, shown only to those who can open the
    / listing page (the owner and admins) and only once it has started.
    - if !@app.listing_draft? && policy(@app).view_store_listing?
      small class="d-badge d-badge-sm d-badge-info py-1 ms-2"
        = t("apps.store_listings.status.#{@app.listing_status}")

- content_for :section_rightpanel do
  - if current_user&.manage?(app: @app)
    .d-join
      - if !@app.archived
        = button_link_to '', new_app_scheme_path(@app), 'plus-square', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.new_scheme'), turbo_frame: :modal }
        = button_link_to '', edit_app_path(@app), 'edit', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.edit_app'), turbo_frame: :modal }
      - if !@app.archived && policy(@app).view_store_listing?
        / Task 25: the owner's route to publishing on our own store.
        = button_link_to '', app_store_listing_path(@app), 'store', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.store_listing'), turbo_frame: '_top' }
      - if !@app.archived && policy(ListingEdit.new(app: @app)).update?
        / Task 27e-c: the store-listing text editor (name, short and full description).
        = button_link_to '', app_listing_text_path(@app), 'list-alt', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.listing_text'), turbo_frame: '_top' }
      - if !@app.archived && policy(ListingEdit.new(app: @app)).update?
        / Z-P5/Z-P6: the "App content" section (content rating, Data Safety, store flags, privacy policy).
        = button_link_to '', app_app_content_path(@app), 'clipboard-list', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.app_content'), turbo_frame: '_top' }
      - if !@app.archived && policy(@app).update?
        / Z-P21: machine translation of the listing (reviewed translations are published in the index).
        = button_link_to '', app_listing_translations_path(@app), 'language', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.listing_translations'), turbo_frame: '_top' }
      - if !@app.archived && policy(MigratedComment.new(app: @app)).index?
        / Z-P8: the reviews inbox (read reviews, write the developer reply).
        = button_link_to '', app_reviews_path(@app), 'comments', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.reviews'), turbo_frame: '_top' }
      - if !@app.archived && policy(CrashReport.new(app: @app)).index?
        / Z-P17: the opt-in crash/vitals inbox.
        = button_link_to '', app_crash_reports_path(@app), 'bug', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.crash_reports'), turbo_frame: '_top' }
      - if !@app.archived && policy(AnonymousReview.new(app: @app)).index?
        / Z-P9: moderate anonymous reviews the automated moderator held.
        = button_link_to '', app_anonymous_reviews_path(@app), 'user-shield', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.anonymous_reviews'), turbo_frame: '_top' }
      - if !@app.archived && policy(@app).show?
        / Z-P2/Z-P3/Z-P4: the automated-review policy status.
        = button_link_to '', app_policy_status_path(@app), 'shield-halved', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.policy_status'), turbo_frame: '_top' }
      - if !@app.archived && policy(@app).show?
        / Z-P22: the deep-link verification checker (App Links / assetlinks.json).
        = button_link_to '', app_deep_link_verification_path(@app), 'link', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.deep_link_verification'), turbo_frame: '_top' }
      - if !@app.archived && policy(AppApiToken.new(app: @app)).index?
        / Task 34a-7: the owner's API tokens for CI publishing.
        = button_link_to '', app_api_tokens_path(@app), 'key', \
          class: 'd-join-item d-btn d-tooltip', \
          data: { tip: t('apps.show.api_tokens'), turbo_frame: '_top' }
      = button_link_to '', app_path(@app), 'trash-alt', \
        class: 'd-join-item d-btn d-tooltip text-error', \
        data: { tip: t('apps.show.destroy_app'), turbo_method: :delete, turbo_confirm: "#{t('apps.messages.confirm.delete_app', name: @app.name)}" }

= turbo_frame_tag @app do
  - unless @app.setup_checklist_complete?
    = render 'apps/setup_checklist', app: @app

  = render 'schemes', app: @app

  / Task 36b-7: the Google registration status of this app's package name, for the owner and admins.
  - if !@app.archived && policy(@app).view_store_listing?
    = render 'google_registration', app: @app

  / Task 27d-e2-b: store-listing graphics, for whoever may change them (the same rule the endpoints use).
  - if !@app.archived && policy(ListingGraphic.new(app: @app)).create?
    = render 'listing_graphics', app: @app

  - if current_user&.manage?(app: @app)
    == render "collaborators", app: @app
