- content_for :title do
  = @title

.row
  .col-md-12
    .card
      .card-body class="space-y-4"
        - if @sdk_url.blank? || @publishable_key.blank?
          //- Payment (B-PAY) task: operator hasn't supplied one or both of
          //- the two values the embed below needs — see handover.md.
          //- Fails visibly here instead of loading a broken widget.
          p.text-error = t('.not_configured')
        - else
          p#payment-message.hidden
          form#payment-form
            #unified-checkout
            button#submit type="submit" class="d-btn d-btn-primary"
              span#button-text = t('.pay_button')

          script src="https://#{@sdk_url}/HyperLoader.js"
          javascript:
            (function () {
              var clientSecret = #{@client_secret.to_json};
              var publishableKey = #{@publishable_key.to_json};
              var returnUrl = #{pay_app_store_listing_url(@app).to_json};

              var messageEl = document.getElementById('payment-message');
              function showMessage(text) {
                messageEl.textContent = text;
                messageEl.classList.remove('hidden');
              }

              var hyper = Hyper(publishableKey);

              // Returning from a redirect-based auth step (Hyperswitch
              // appends payment_intent_client_secret to return_url) — check
              // status instead of re-rendering the form. This is a UX
              // convenience only: the webhook (HyperswitchWebhooksController),
              // not this page, is what actually flips the app live.
              var returnedSecret = new URLSearchParams(window.location.search)
                .get('payment_intent_client_secret');
              if (returnedSecret) {
                hyper.retrievePayment(returnedSecret).then(function (res) {
                  var payment = res.payment || {};
                  switch (payment.status) {
                    case 'succeeded':
                      showMessage(#{t('.status.succeeded').to_json});
                      break;
                    case 'processing':
                      showMessage(#{t('.status.processing').to_json});
                      break;
                    case 'requires_payment_method':
                      showMessage(#{t('.status.requires_payment_method').to_json});
                      break;
                    default:
                      showMessage(#{t('.status.unknown').to_json});
                  }
                });
                return;
              }

              var widgets = hyper.widgets({ appearance: { theme: 'default' }, clientSecret: clientSecret });
              var unifiedCheckout = widgets.create('payment', { layout: 'tabs' });
              unifiedCheckout.mount('#unified-checkout');

              document.getElementById('payment-form').addEventListener('submit', function (e) {
                e.preventDefault();
                document.getElementById('submit').disabled = true;
                hyper.confirmPayment({
                  widgets: widgets,
                  confirmParams: { return_url: returnUrl },
                  redirect: 'always'
                }).then(function (result) {
                  document.getElementById('submit').disabled = false;
                  if (result.error) {
                    showMessage(result.error.message || #{t('.status.unknown').to_json});
                  }
                });
              });
            })();

        p.text-xs.opacity-50 = t('.not_finished')
        = link_to t('.back'), app_store_listing_path(@app), class: 'd-link'
