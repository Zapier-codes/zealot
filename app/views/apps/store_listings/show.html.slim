ruby:
  status = @app.listing_status
  badge = { 'draft' => 'ghost', 'awaiting_payment' => 'warning',
            'live' => 'success', 'suspended' => 'error' }[status]

- content_for :title do
  = @title

- content_for :section_title do
  = @title
  small class="pl-2 text-sm"
    = @app.name

.row
  .col-md-12
    .card
      .card-header
        h3.card-title class="flex items-center gap-2"
          = t('.status_title')
          span class="d-badge d-badge-#{badge}"
            = t("apps.store_listings.status.#{status}")
      .card-body class="space-y-4"
        p = t(".#{status}.body")

        - if @profile.present?
          p.opacity-70
            = t('.publisher', name: @profile.display_name, kind: t("publisher_profiles.kinds.#{@profile.kind}"))
            - if @app.owner&.user == current_user
              = ' '
              = link_to t('.edit_publisher'), edit_publisher_profile_path(return_to: app_store_listing_path(@app)), class: 'd-link'

        - if status == 'live' && @app.publisher_display_name.present?
          p.opacity-70 = t('.live.shown_as', name: @app.publisher_display_name)

        - incomplete = %w[draft awaiting_payment].include?(status) && @missing.present?
        - if incomplete
          div class="space-y-1" id="listing-incomplete"
            p.font-medium = t('.incomplete.title')
            p.text-sm.opacity-70
              = t('.incomplete.body', missing: @missing.map { |item| item.key == :screenshots ? t('apps.store_listings.missing.screenshots', count: item.count, target: item.target) : t('apps.store_listings.missing.icon') }.to_sentence)
            p.text-sm
              = link_to t('.incomplete.graphics_link'), app_path(@app, anchor: 'listing-graphics'), class: 'd-link'
            - if @missing.any? { |item| item.key == :icon }
              p.text-sm.opacity-70 = t('.incomplete.icon_hint')

        - if status == 'draft' && policy(@app).list_on_store?
          = button_to t('.publish'), app_store_listing_path(@app), method: :post, class: 'd-btn d-btn-primary', disabled: incomplete

        - if status == 'awaiting_payment' && policy(@app).list_on_store?
          div class="space-y-2"
            = button_to t('.pay'), pay_app_store_listing_path(@app), method: :post, class: 'd-btn d-btn-primary', disabled: incomplete

        - if status == 'awaiting_payment' && policy(@app).mark_paid?
          div class="space-y-2"
            p.text-sm.opacity-70 = t('.mark_paid_hint')
            = button_to t('.mark_paid'), mark_paid_app_store_listing_path(@app), method: :patch, class: 'd-btn d-btn-warning'
