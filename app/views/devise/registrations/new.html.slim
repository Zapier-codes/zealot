- content_for :title do
  = t('.sign_up')

div class="d-section mx-auto max-w-6xl px-4 md:px-6 py-6 md:py-12"
  div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 items-center my-2"
    div class="col-span-2 order-2 md:order-1 auth-intro"
      == render 'devise/shared/intro'
    div class="col-span-3 order-1 md:order-2"
      div class="auth-shell"
        div class="auth-glow-primary"
        div class="auth-glow-secondary"
        div class="auth-glow-accent"
        div class="auth-card p-6 md:p-8"
          div.d-tabs.d-tabs-box.bg-transparent.border-none.p-0
            input class="d-tab" type="radio" aria-label=t('.sign_up') checked='checked'
            div class="d-tab-content px-0 py-3"
              - if Setting.registrations_enabled
                div class="grid grid-cols-1 md:grid-cols-2 gap-3 my-2"
                  div class="order-1 border-base-200 md:border-r-2 md:pe-4"
                    = simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
                      = f.input :username,
                          required: true,
                          autofocus: true,
                          input_html: { autocomplete: "username", class: 'form-control' }
                      = f.input :email,
                          required: true,
                          autofocus: true,
                          input_html: { autocomplete: "email", class: 'form-control' }
                      = f.input :password,
                          required: true,
                          hint: t('devise.shared.minimum_password_length', count: @minimum_password_length),
                          input_html: { autocomplete: "new-password" }
                      = f.input :password_confirmation,
                          required: true,
                          input_html: { autocomplete: "new-password" }
                      = f.button :submit, t('.register'), class: 'd-btn d-btn-primary w-full'
                  div class="order-2"
                    == render 'devise/shared/links'
              - else
                .pt-3.text-warning = t('.register_closed')
                .d-divider OR
                == render 'devise/shared/links'
