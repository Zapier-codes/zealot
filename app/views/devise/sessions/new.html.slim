- content_for :title do
  = t('.sign_in')

div class="d-section mx-auto max-w-6xl px-4 md:px-6 py-6 md:py-12"
  div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 items-center my-2"
    div class="col-span-2 order-2 md:order-1 auth-intro"
      == render 'devise/shared/intro'
    div class="col-span-3 order-1 md:order-2"
      div class="auth-shell"
        div class="auth-glow-primary"
        div class="auth-glow-secondary"
        div class="auth-glow-accent"
        div class="auth-card p-6 md:p-8"
          div.d-tabs.d-tabs-box.bg-transparent.border-none.p-0[
            data-controller='tab-switch'
            data-tab-switch-default-tab-value='normal'
            data-tab-switch-active-tab-value=@active_tab
          ]
            == render 'devise/shared/tab_normal', active_tab: @active_tab
            == render 'devise/shared/tab_passwordless', active_tab: @active_tab
            == render 'devise/shared/tab_ldap', active_tab: @active_tab
