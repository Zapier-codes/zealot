- content_for :title do
  = t('.title', default: site_title)

.landing-page

  / ---------------------------------------------------------------------
  / Hero
  / ---------------------------------------------------------------------
  section class="landing-hero relative overflow-hidden"
    div class="landing-hero-glow-primary"
    div class="landing-hero-glow-secondary"
    div class="landing-hero-glow-accent"
    div class="landing-hero-grid"

    div class="relative mx-auto max-w-5xl px-4 md:px-6 py-16 md:py-28 text-center"
      span class="landing-eyebrow" = t('home.eyebrow')

      h1 class="landing-headline mt-6"
        span class="block text-base-content/80 text-xl md:text-2xl font-medium mb-3" = t('home.title_prefix')
        span class="landing-shine" = site_title

      p class="landing-subtext mx-auto mt-6 max-w-2xl text-base md:text-lg text-base-content/70"
        = t('home.hero_description')

      div class="mt-10 flex items-center justify-center"
        = link_to t('home.get_started'), new_user_session_path, class: 'd-btn d-btn-primary d-btn-lg landing-cta'

  / ---------------------------------------------------------------------
  / Animated stat counters
  / Big totals (compact) count up as plain digits, then switch to "5M+" /
  / "10M+" shorthand once they reach a million — see counter_controller.js.
  / ---------------------------------------------------------------------
  section class="relative mx-auto max-w-4xl px-4 md:px-6 pb-16 md:pb-24"
    div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6"
      - @stats.each do |stat|
        div class="landing-stat-card"
          div class="flex items-baseline justify-center gap-1"
            - if stat[:compact]
              span class="landing-counter text-4xl md:text-5xl font-bold tabular-nums" data-controller="counter" data-counter-count-value=stat[:value] data-counter-compact-value="true"
                = compact_count(stat[:value])
            - else
              span class="landing-counter text-4xl md:text-5xl font-bold tabular-nums" data-controller="counter" data-counter-count-value=stat[:value]
                = number_with_delimiter(stat[:value])
              - if stat[:suffix]
                span class="text-4xl md:text-5xl font-bold text-primary" = stat[:suffix]
          p class="mt-2 text-sm md:text-base text-base-content/60 text-center" = stat[:label]

  / ---------------------------------------------------------------------
  / Global reach — 3D globe with country pins
  / ---------------------------------------------------------------------
  section class="relative py-14 md:py-20 landing-reach-section"
    div class="mx-auto max-w-5xl px-4 md:px-6 text-center"
      h2 class="text-2xl md:text-3xl font-semibold" = t('home.reach.title')
      p class="mt-3 text-base-content/60 max-w-xl mx-auto" = t('home.reach.description')

      div class="landing-globe-wrap mt-8" data-controller="globe" data-globe-points-value=@countries.to_json data-globe-lights-value=@lights.to_json
        noscript
          div class="landing-flag-grid"
            - @countries.each do |country|
              span class="landing-flag-pill" title=country[:name]
                img class="landing-flag-icon" src="https://flagcdn.com/24x18/#{country[:code].downcase}.png" alt=country[:code] width="24" height="18"
                span class="text-xs font-semibold tracking-wide" = country[:code]

  / ---------------------------------------------------------------------
  / Partners marquee (scrolls left) + Sponsors marquee (scrolls right).
  / Deliberately borderless and full-bleed: no headings, no pills, and
  / the rows fade out at both edges so they melt into the page.
  / ---------------------------------------------------------------------
  section class="landing-brands"
    div class="landing-marquee-mask"
      div class="landing-marquee landing-marquee-left"
        - (@partners + @partners).each do |partner|
          span class="landing-marquee-item"
            img class="landing-marquee-logo" src="https://cdn.simpleicons.org/#{partner[:icon]}" alt="" loading="lazy" decoding="async" width="44" height="44"
            span class="landing-marquee-name" = partner[:name]

    div class="landing-marquee-mask"
      div class="landing-marquee landing-marquee-right"
        - (@sponsors + @sponsors).each do |sponsor|
          span class="landing-marquee-item"
            img class="landing-marquee-logo" src="https://cdn.simpleicons.org/#{sponsor[:icon]}" alt="" loading="lazy" decoding="async" width="44" height="44"
            span class="landing-marquee-name" = sponsor[:name]
