- content_for :title do
  = t('.title', default: site_title)

.landing-page

  / ---------------------------------------------------------------------
  / Hero
  / ---------------------------------------------------------------------
  section class="landing-hero relative overflow-hidden"
    div class="landing-hero-glow-primary"
    div class="landing-hero-glow-secondary"
    div class="landing-hero-glow-accent"
    div class="landing-hero-grid"

    div class="relative mx-auto max-w-5xl px-4 md:px-6 py-16 md:py-28 text-center"
      span class="landing-eyebrow" = t('home.eyebrow')

      h1 class="landing-headline mt-6"
        span class="block text-base-content/80 text-xl md:text-2xl font-medium mb-3" = t('home.title_prefix')
        span class="landing-shine" = site_title

      p class="landing-subtext mx-auto mt-6 max-w-2xl text-base md:text-lg text-base-content/70"
        = t('home.hero_description')

      div class="mt-10 flex flex-wrap items-center justify-center gap-3"
        = link_to t('home.get_started'), new_user_registration_path, class: 'd-btn d-btn-primary d-btn-lg shadow-lg shadow-primary/30'
        = link_to t('home.sign_in'), new_user_session_path, class: 'd-btn d-btn-ghost d-btn-lg border border-base-content/15'
        - if Setting.guest_mode
          = link_to t('home.continue_as_guest'), dashboard_path, class: 'd-btn d-btn-soft d-btn-lg'

  / ---------------------------------------------------------------------
  / Animated stat counters
  / ---------------------------------------------------------------------
  section class="relative mx-auto max-w-6xl px-4 md:px-6 pb-16 md:pb-24"
    div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6"
      - @stats.each do |stat|
        div class="landing-stat-card"
          div class="flex items-baseline justify-center gap-1"
            span class="landing-counter text-3xl md:text-5xl font-bold tabular-nums" data-controller="counter" data-counter-count-value=stat[:value] 0
            span class="text-3xl md:text-5xl font-bold text-primary" = stat[:suffix]
          p class="mt-2 text-sm md:text-base text-base-content/60 text-center" = stat[:label]

  / ---------------------------------------------------------------------
  / Global reach
  / ---------------------------------------------------------------------
  section class="relative py-14 md:py-20 landing-reach-section"
    div class="mx-auto max-w-5xl px-4 md:px-6 text-center"
      h2 class="text-2xl md:text-3xl font-semibold" = t('home.reach.title')
      p class="mt-3 text-base-content/60 max-w-xl mx-auto" = t('home.reach.description')

      div class="landing-flag-grid mt-8"
        - @countries.each do |code|
          span class="landing-flag-pill" title=code
            span class="landing-flag-dot"
            span class="text-xs font-semibold tracking-wide" = code

  / ---------------------------------------------------------------------
  / Partners marquee (scrolls left) + Sponsors marquee (scrolls right)
  / ---------------------------------------------------------------------
  section class="relative py-14 md:py-20 border-t border-base-content/10"
    div class="mx-auto max-w-6xl px-4 md:px-6"
      p class="text-center text-sm uppercase tracking-widest text-base-content/50 mb-6" = t('home.partners.title')
      div class="landing-marquee-mask"
        div class="landing-marquee landing-marquee-left"
          - (@partners + @partners).each do |name|
            span class="landing-marquee-pill" = name

  section class="relative pb-20 md:pb-28"
    div class="mx-auto max-w-6xl px-4 md:px-6"
      p class="text-center text-sm uppercase tracking-widest text-base-content/50 mb-6" = t('home.sponsors.title')
      div class="landing-marquee-mask"
        div class="landing-marquee landing-marquee-right"
          - (@sponsors + @sponsors).each do |name|
            span class="landing-marquee-pill landing-marquee-pill-accent" = name
