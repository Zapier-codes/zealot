ruby:
  section_title = yield :section_title
  right_panel = yield :section_rightpanel
  breadcrumb = yield :breadcrumb
  breadcrumbs = @breadcrumbs

// Breadcrumbs (moved here from the removed top nav)
- if breadcrumbs.present? && user_signed_in_or_guest_mode?
  div class="min-w-0" data-breadcrumbs-container
    == render 'layouts/breadcrumbs', breadcrumbs: breadcrumbs

// Content Header (Page header)
- if section_title.present?
  .app-container-header class="console-header flex min-w-0 items-center justify-between py-4"
    div class="min-w-0 items-center"
      h2 class="text-2xl font-bold tracking-tight" = yield :section_title

    - if right_panel.present?
      div class="flex items-center"
        = right_panel
- else
  div class="my-1"
