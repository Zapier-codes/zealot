#!/usr/bin/env bash
# bin/bootstrap-publishing  (Task 34d-3, D-Store leaf 37, `7.a.xii.zi`; two-identity split: Task 34d-5, D-Store leaf 39,
# `7.a.xiii.zi`; written, NOT run)
#
# Does, through Zealot's API, the setup that D-Store HANDOVER leaf 16 listed as the operator's steps 3 and 4.
# It is run TWICE, once per identity, because the two halves belong to different people (least privilege):
#
#   --only signing-key   run as the PLATFORM ADMIN (the organisation). The org-wide Android signing key exists.
#                        (Task 34d-1: /api/android_signing_key). The admin does not own or publish any app.
#   --only app           run as a DEVELOPER account (never the admin). The app, its scheme and an Android channel
#                        exist, and a per-app CI token exists and is stored where the build job reads it
#                        (Task 34d-2: /api/apps/:id/api_tokens). That developer owns the app and the token acts
#                        as that developer (decision 34-2), with the one scope `publish`.
#
# Signing is not done by the developer or by the CI job. The CI builds an UNSIGNED bundle and uploads it; Zealot
# splits it into APKs and signs them with the organisation's key when it processes the upload
# (AnthropicAssetDeliveryJob -> AndroidSigningKey.current). So one org key signs every developer's app, and a
# developer's token can only upload, never read or change that key.
#
# Safe to run again: every step looks first and only creates what is missing. It never replaces an existing
# signing key (rotating that key changes the signature of every future release; it is a deliberate act, see
# the notes in the API) and it makes a new CI token only when none with that name is live, or with --rotate.
#
# Needs: bash 4+, curl 7.55+, jq. With --github-repo also the GitHub CLI (`gh`), already logged in with
# permission to write that repository's Actions secrets and variables.
#
# Credentials, never on the command line (argv shows in `ps`, shell history and CI logs):
#   the run's Zealot user token        env ZEALOT_ADMIN_TOKEN, or --admin-token-file, or a hidden prompt (the
#                                      admin's for --only signing-key, the developer's for --only app);
#                                      OR let this script sign in and read it (--sign-in, below)
# --sign-in EMAIL signs in with Zealot's own login form (the same two page loads a browser makes) and reads the
# account's API token off its profile page, so no token is copied by hand. The password comes from env
# ZEALOT_PASSWORD, --password-file, a hidden prompt, or is made here: --new-password-file F writes a random
# 48-character password (36 bytes from the system's secure random source) to the new file F, mode 0600.
# Zealot's login form REGISTERS an email it does not know, so a mistyped address makes a stray account, and it
# makes ordinary DEVELOPER accounts (when the server allows registrations): that is how the developer account for
# --only app is created. The org signing key needs a PLATFORM ADMIN, and the one email that can be the admin is
# the server's ZEALOT_ADMIN_SIGNUP_EMAIL, created only through the admin entry (--admin-entry), which only
# --only signing-key accepts. One attempt only, never retried: Devise locks an account after 5 wrong passwords.
#   the keystore passwords             env KEYSTORE_PASSWORD / KEY_PASSWORD, or --keystore-password-file /
#                                      --key-password-file, or a hidden prompt (only asked when a key is to be added)
# The new CI token is never printed. It goes to the GitHub repository's secret ZEALOT_APP_TOKEN (--github-repo)
# and/or a new file with mode 0600 (--secret-out). One of the two is required when a token is to be made.
#
# Example (Termux), Storeapp, two runs:
#   export ZEALOT_URL=https://<your zealot host>
#   # 1. the organisation: the signing key (skip when the key is already in Zealot)
#   bash ~/zealot/bin/bootstrap-publishing --only signing-key \
#     --sign-in <admin email> --admin-entry --keystore ~/storage/downloads/release.jks --key-alias release
#   # 2. the developer account that owns and publishes Storeapp (made on the spot if it does not exist)
#   bash ~/zealot/bin/bootstrap-publishing --only app \
#     --sign-in <developer email> --new-password-file ~/zealot-dev.pw \
#     --app-name Storeapp --bundle-id com.vythera.vyxelapps \
#     --github-repo Zapier-codes/Storeapp --secret-out ~/storeapp-zealot.token
# (--secret-out as well, because GitHub will not hand the secret back and the first held upload by hand, leaf 16
# step 6, needs it; delete that file when the workflow publishes by itself.)
#
# Exit status: 0 done (or --dry-run finished), 1 anything else. Nothing here prints a secret.

set -euo pipefail
umask 077

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
  cat <<'EOF'

Options:
  --only signing-key|app       required: which half to do, as which identity (see the top of this help)
  --url URL                    Zealot's address (or env ZEALOT_URL); must be https (http only for localhost)
  --app-name NAME              required with --only app: the app's name in Zealot (matched exactly)
  --bundle-id ID               required with --only app: the Android application id; must equal the .aab's, or
                               uploads are refused
  --scheme-name NAME           default: Release
  --channel-name NAME          default: Android
  --keystore FILE              --only signing-key: add this keystore as the org signing key when none exists
                               (never replaces one)
  --key-alias ALIAS            required with --keystore
  --keystore-password-file F   --key-password-file F   --admin-token-file F
  --sign-in EMAIL              sign in as this account and read its user token (instead of --admin-token-file)
  --admin-entry                --only signing-key with --sign-in: use the admin entry, the only way the admin email
                               can be created; refused with --only app
  --password-file F            with --sign-in: the account's existing password (or env ZEALOT_PASSWORD, or a prompt)
  --new-password-file F        with --sign-in: make a random password, save it to the NEW file F (mode 0600), and
                               use it; if the account already exists it is not accepted and F is removed again
  --token-name NAME            default: github-actions (a live token with this name is reused unless --rotate)
  --expiry 30|90|365|none      default: 90 (days)
  --rotate                     make a new token and, once it is stored, revoke the older live ones of that name
  --github-repo OWNER/REPO     store ZEALOT_APP_TOKEN (secret), ZEALOT_URL and ZEALOT_CHANNEL_KEY (variables)
  --secret-out FILE            write the new token to this new file (mode 0600); refuses to overwrite
  --dry-run                    only read from Zealot and say what would be done
  -h, --help
EOF
}

log() { printf '%s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but is not installed"; }

# ---- arguments ------------------------------------------------------------------------------------------
ZEALOT_URL="${ZEALOT_URL:-}"
ONLY="" APP_NAME="" BUNDLE_ID="" SCHEME_NAME="Release" CHANNEL_NAME="Android"
KEYSTORE="" KEY_ALIAS="" KEYSTORE_PASSWORD_FILE="" KEY_PASSWORD_FILE="" ADMIN_TOKEN_FILE=""
SIGN_IN_EMAIL="" PASSWORD_FILE="" NEW_PASSWORD_FILE="" ADMIN_ENTRY=0
TOKEN_NAME="github-actions" EXPIRY="90" ROTATE=0 GITHUB_REPO="" SECRET_OUT="" DRY_RUN=0

while (($#)); do
  case "$1" in
    --only) ONLY="${2:?--only needs signing-key or app}"; shift 2 ;;
    --url) ZEALOT_URL="${2:?--url needs a value}"; shift 2 ;;
    --app-name) APP_NAME="${2:?--app-name needs a value}"; shift 2 ;;
    --bundle-id) BUNDLE_ID="${2:?--bundle-id needs a value}"; shift 2 ;;
    --scheme-name) SCHEME_NAME="${2:?--scheme-name needs a value}"; shift 2 ;;
    --channel-name) CHANNEL_NAME="${2:?--channel-name needs a value}"; shift 2 ;;
    --keystore) KEYSTORE="${2:?--keystore needs a value}"; shift 2 ;;
    --key-alias) KEY_ALIAS="${2:?--key-alias needs a value}"; shift 2 ;;
    --keystore-password-file) KEYSTORE_PASSWORD_FILE="${2:?needs a value}"; shift 2 ;;
    --key-password-file) KEY_PASSWORD_FILE="${2:?needs a value}"; shift 2 ;;
    --admin-token-file) ADMIN_TOKEN_FILE="${2:?needs a value}"; shift 2 ;;
    --sign-in) SIGN_IN_EMAIL="${2:?--sign-in needs an email address}"; shift 2 ;;
    --admin-entry) ADMIN_ENTRY=1; shift ;;
    --password-file) PASSWORD_FILE="${2:?--password-file needs a value}"; shift 2 ;;
    --new-password-file) NEW_PASSWORD_FILE="${2:?--new-password-file needs a value}"; shift 2 ;;
    --token-name) TOKEN_NAME="${2:?--token-name needs a value}"; shift 2 ;;
    --expiry) EXPIRY="${2:?--expiry needs a value}"; shift 2 ;;
    --rotate) ROTATE=1; shift ;;
    --github-repo) GITHUB_REPO="${2:?--github-repo needs a value}"; shift 2 ;;
    --secret-out) SECRET_OUT="${2:?--secret-out needs a value}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown option: $1 (see --help)" ;;
  esac
done

need curl
need jq
case "$ONLY" in
  signing-key)
    # The organisation's half: nothing about an app, a token or a repository belongs here.
    [[ -z $APP_NAME && -z $BUNDLE_ID && -z $GITHUB_REPO && -z $SECRET_OUT ]] ||
      die "--app-name, --bundle-id, --github-repo and --secret-out belong to --only app, not to the signing key run"
    ((!ROTATE)) || die "--rotate belongs to --only app"
    ;;
  app)
    # The developer's half: never the admin, and never the key.
    [[ -n $APP_NAME ]] || die "--app-name is required with --only app"
    [[ -n $BUNDLE_ID ]] || die "--bundle-id is required with --only app"
    ((!ADMIN_ENTRY)) || die "--admin-entry is the admin's way in; the app and its token belong to a developer account (--only app)"
    [[ -z $KEYSTORE && -z $KEY_ALIAS && -z $KEYSTORE_PASSWORD_FILE && -z $KEY_PASSWORD_FILE ]] ||
      die "the keystore options belong to --only signing-key, run as the admin"
    ;;
  *) die "--only is required: signing-key (run as the admin) or app (run as a developer); see --help" ;;
esac
[[ -n $ZEALOT_URL ]] || die "set ZEALOT_URL or pass --url"
ZEALOT_URL="${ZEALOT_URL%/}"
case "$ZEALOT_URL" in
  https://* | http://localhost | http://localhost:* | http://127.0.0.1 | http://127.0.0.1:*) ;;
  *) die "the address must start with https:// (a token must not cross the network in clear text)" ;;
esac
case "$EXPIRY" in 30 | 90 | 365 | none) ;; *) die "--expiry must be 30, 90, 365 or none" ;; esac
[[ -z $KEYSTORE || -n $KEY_ALIAS ]] || die "--key-alias is required with --keystore"
[[ -z $KEYSTORE || -r $KEYSTORE ]] || die "cannot read the keystore file: $KEYSTORE"
[[ -z $GITHUB_REPO ]] || need gh
[[ -z $SECRET_OUT || ! -e $SECRET_OUT ]] || die "$SECRET_OUT already exists; choose a new file name"
if [[ -n $SIGN_IN_EMAIL ]]; then
  email_re='^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'
  [[ $SIGN_IN_EMAIL =~ $email_re ]] || die "--sign-in needs an email address"
  [[ -z $ADMIN_TOKEN_FILE ]] || die "use either --sign-in or --admin-token-file, not both"
  [[ -z $NEW_PASSWORD_FILE || -z $PASSWORD_FILE ]] || die "use either --password-file or --new-password-file, not both"
  [[ -z $NEW_PASSWORD_FILE || ! -e $NEW_PASSWORD_FILE ]] || die "$NEW_PASSWORD_FILE already exists; choose a new file name"
  if ((DRY_RUN)) && [[ -n $NEW_PASSWORD_FILE ]]; then
    die "a dry run must not create an account: sign in with an existing password (--password-file, ZEALOT_PASSWORD or the prompt)"
  fi
elif [[ -n $PASSWORD_FILE || -n $NEW_PASSWORD_FILE ]] || ((ADMIN_ENTRY)); then
  die "--password-file, --new-password-file and --admin-entry only work together with --sign-in"
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# load_secret DEST ENV_NAME SOURCE_FILE PROMPT: the value goes to the file DEST (no trailing newline), never to argv.
load_secret() {
  local dest="$1" var="$2" src="$3" prompt="$4" value
  if [[ -n $src ]]; then
    [[ -r $src ]] || die "cannot read $src"
    tr -d '\r\n' <"$src" >"$dest"
  elif [[ -n ${!var:-} ]]; then
    printf '%s' "${!var}" >"$dest"
  elif [[ -t 0 ]]; then
    read -rsp "$prompt: " value
    printf '\n' >&2
    printf '%s' "$value" >"$dest"
  else
    die "$prompt: set $var, pass a file option, or run this on a terminal"
  fi
  [[ -s $dest ]] || die "$prompt is empty"
}

# ---- talking to Zealot ----------------------------------------------------------------------------------
# api METHOD PATH [curl options...]: the answer's body is in $WORK/body, its HTTP status in $STATUS.
# No automatic retry: a retried POST that had already worked would make a second app or token.
STATUS=""
api() {
  local method="$1" path="$2"
  shift 2
  STATUS="$(curl -sS --max-time 120 -o "$WORK/body" -w '%{http_code}' -X "$method" "$ZEALOT_URL$path" "$@")" ||
    die "no answer from $ZEALOT_URL ($method $path)"
}

# What Zealot said was wrong: its "error" text, else the start of the body. Never the request.
reason() {
  local text
  text="$(jq -r '.error // empty' "$WORK/body" 2>/dev/null || true)"
  [[ -n $text ]] || text="$(head -c 200 "$WORK/body" | tr '\n' ' ')"
  printf '%s' "$text"
}

# ---- step 0 (optional): sign in with a password and read the user token off the profile page --------------
# Zealot has no password-to-token API. Its login form (Users::SessionsController#create) signs a known email in
# and registers an unknown one, and the signed-in profile page (/users/edit, the "API Token" card) shows the
# account's user token. This makes those page loads with a throwaway cookie jar. The password and the token live
# only in files inside $WORK (mode 0600, removed on exit) and never in argv, a URL or the output.
GENERATED_PASSWORD=0

sign_in_failed() {
  if ((GENERATED_PASSWORD)); then
    rm -f "$NEW_PASSWORD_FILE"
    log "password: removed $NEW_PASSWORD_FILE, the generated password was never accepted"
  fi
  die "$1"
}

generate_password() {
  local pw
  if command -v openssl >/dev/null 2>&1; then
    pw="$(openssl rand -base64 36 | tr -d '\n')"
  else
    pw="$(head -c 36 /dev/urandom | base64 | tr -d '\n')"
  fi
  [[ ${#pw} -ge 48 ]] || die "could not make a random password"
  printf '%s' "$pw" >"$WORK/password"
  (set -C; printf '%s\n' "$pw" >"$NEW_PASSWORD_FILE") 2>/dev/null ||
    die "could not create $NEW_PASSWORD_FILE (the folder must exist and the file must not)"
  GENERATED_PASSWORD=1
  log "password: made a random 48-character password and saved it to $NEW_PASSWORD_FILE (mode 600); put it in a password manager, then delete the file"
}

sign_in_for_token() {
  local jar="$WORK/cookies" csrf="" token=""

  if [[ -n $NEW_PASSWORD_FILE ]]; then
    generate_password
  else
    load_secret "$WORK/password" ZEALOT_PASSWORD "$PASSWORD_FILE" "Zealot password for $SIGN_IN_EMAIL"
  fi

  # The login page gives the session cookie, and a CSRF token if the app checks one (it may not today).
  api GET /users/sign_in -c "$jar" -b "$jar"
  [[ $STATUS == 200 ]] || sign_in_failed "the login page answered $STATUS (is $ZEALOT_URL Zealot's own address, not a redirect?)"
  csrf="$(tr '\n' ' ' <"$WORK/body" | grep -oE '<meta[^>]*name="csrf-token"[^>]*>' | grep -oE 'content="[^"]+"' | head -1 | sed -E 's/^content="//; s/"$//' || true)"

  local -a form=(--data-urlencode "user%5Bemail%5D=$SIGN_IN_EMAIL" --data-urlencode "user%5Bpassword%5D@$WORK/password" --data-urlencode "tab=normal")
  if ((ADMIN_ENTRY)); then form+=(--data-urlencode "admin_entry=1"); fi
  if [[ -n $csrf ]]; then
    printf '%s' "$csrf" >"$WORK/csrf"
    form+=(--data-urlencode "authenticity_token@$WORK/csrf")
  fi

  # One attempt. A wrong password is a redirect back to the login page, not an error status, so success is
  # decided by the next request, not by this answer.
  api POST /users/sign_in -c "$jar" -b "$jar" "${form[@]}"
  case "$STATUS" in
    422) sign_in_failed "Zealot refused the sign-in form (422): the email is not valid or the password is outside 6 to 128 characters" ;;
    429 | 5??) sign_in_failed "Zealot answered $STATUS to the sign-in; try again later" ;;
  esac

  api GET /users/edit -c "$jar" -b "$jar"
  if [[ $STATUS == 200 ]]; then
    token="$(tr '\n' ' ' <"$WORK/body" | grep -oE '<input[^>]*clipboard-center-target="source"[^>]*>' | grep -oE 'value="[0-9a-f]{32}"' | head -1 | sed -E 's/^value="//; s/"$//' || true)"
  fi
  rm -f "$WORK/body" "$WORK/password" "$WORK/csrf" "$jar"
  [[ $token =~ ^[0-9a-f]{32}$ ]] ||
    sign_in_failed "not signed in as $SIGN_IN_EMAIL (one attempt made): the password was not accepted, the account is locked, the email already has an account while a new password was generated, or registrations are off. Only the server's admin email can be created, and only with --admin-entry."
  printf '%s' "$token" >"$WORK/utoken"
  token=""
  log "sign-in: signed in as $SIGN_IN_EMAIL; its user token was read from the profile page and is kept only in a temporary file"
}

# The user token. The two newer doors (signing key, tokens) want it in an Authorization header, the older
# /api/apps, schemes and channels want it as a `token` field: in the BODY for POST, and for the two GETs the
# only place is the query string (the weakness decision 34-1 records). Kept out of argv either way.
if [[ -n $SIGN_IN_EMAIL ]]; then
  sign_in_for_token
else
  load_secret "$WORK/utoken" ZEALOT_ADMIN_TOKEN "$ADMIN_TOKEN_FILE" "Zealot admin user token"
fi
printf 'Authorization: Bearer %s\n' "$(cat "$WORK/utoken")" >"$WORK/auth"
AUTH=(-H "@$WORK/auth")
OLD_TOKEN=(--data-urlencode "token@$WORK/utoken")

refused() {
  case "$STATUS" in
    401) die "Zealot refused the user token (401): wrong, locked, or not a user token" ;;
    403) die "that user is not allowed to do this (403); the signing key needs a platform admin, the app and token calls an owner or admin" ;;
  esac
  die "unexpected answer $STATUS: $(reason)"
}

# ---- step 3: the org signing key ------------------------------------------------------------------------
step_signing_key() {
  api GET /api/android_signing_key "${AUTH[@]}"
  case "$STATUS" in
    200)
      local checksum
      checksum="$(jq -r '.checksum' "$WORK/body")"
      log "signing key: present ($(jq -r '"\(.filename), alias \(.key_alias), checksum \(.checksum)"' "$WORK/body")); left alone"
      if [[ -n $KEYSTORE ]] && command -v sha1sum >/dev/null 2>&1 && [[ "$(sha1sum <"$KEYSTORE" | cut -d' ' -f1)" != "$checksum" ]]; then
        log "  note: the keystore you gave is a different file from the key Zealot holds; nothing was replaced"
      fi
      return 0
      ;;
    404) ;;
    *) refused ;;
  esac

  [[ -n $KEYSTORE ]] || die "no signing key is configured in Zealot: pass --keystore and --key-alias"
  if ((DRY_RUN)); then
    log "signing key: none; would add $KEYSTORE (alias $KEY_ALIAS)"
    return 0
  fi

  load_secret "$WORK/ks_pass" KEYSTORE_PASSWORD "$KEYSTORE_PASSWORD_FILE" "Keystore password"
  load_secret "$WORK/key_pass" KEY_PASSWORD "$KEY_PASSWORD_FILE" "Key password"
  printf '%s' "$KEY_ALIAS" >"$WORK/alias"
  # A copy under a plain name, so an odd path cannot be misread as curl form syntax; the name sent is cleaned.
  cp "$KEYSTORE" "$WORK/upload.jks"
  local fname
  fname="$(basename "$KEYSTORE" | tr -c 'A-Za-z0-9._-' '_')"

  api POST /api/android_signing_key "${AUTH[@]}" \
    -F "keystore=@$WORK/upload.jks;filename=$fname" \
    -F "key_alias=<$WORK/alias" \
    -F "keystore_password=<$WORK/ks_pass" \
    -F "key_password=<$WORK/key_pass"
  case "$STATUS" in
    201) log "signing key: added ($(jq -r '"\(.filename), alias \(.key_alias), checksum \(.checksum)"' "$WORK/body"))" ;;
    409) log "signing key: another request added one first; left alone" ;;
    422) die "Zealot refused the keystore: $(reason) $(jq -c '.entry // empty' "$WORK/body" 2>/dev/null || true)" ;;
    503) die "Zealot cannot check keystores right now (keytool missing on the server): $(reason)" ;;
    *) refused ;;
  esac
}

# ---- step 4a: the app, its scheme, an Android channel ---------------------------------------------------
APP_ID="" SCHEME_ID="" CHANNEL_ID="" CHANNEL_KEY=""

step_app_scheme_channel() {
  api GET /api/apps -G --data-urlencode "scope=active" "${OLD_TOKEN[@]}"
  [[ $STATUS == 200 ]] || refused

  local matches
  matches="$(jq -r --arg n "$APP_NAME" '[.[] | select(.name == $n)] | length' "$WORK/body")"
  ((matches <= 1)) || die "$matches active apps are named \"$APP_NAME\"; rename one so the script can tell them apart"
  APP_ID="$(jq -r --arg n "$APP_NAME" '[.[] | select(.name == $n)] | .[0].id // empty' "$WORK/body")"

  if [[ -n $APP_ID ]]; then
    SCHEME_ID="$(jq -r --arg a "$APP_ID" --arg s "$SCHEME_NAME" \
      '[.[] | select((.id | tostring) == $a) | .schemes[]? | select(.name == $s)] | .[0].id // empty' "$WORK/body")"
    if [[ -n $SCHEME_ID ]]; then
      read -r CHANNEL_ID CHANNEL_KEY < <(jq -r --arg a "$APP_ID" --arg s "$SCHEME_ID" --arg b "$BUNDLE_ID" \
        '[.[] | select((.id | tostring) == $a) | .schemes[]? | select((.id | tostring) == $s) | .channels[]?
          | select((.bundle_id // "") == $b and ((.device_type // "") | ascii_downcase) == "android")]
         | (.[0] // {}) | [(.id // "" | tostring), (.key // "")] | @tsv' "$WORK/body") || true
    fi
  fi

  if [[ -n $APP_ID ]]; then log "app: \"$APP_NAME\" exists (id $APP_ID)"; fi
  if [[ -n $SCHEME_ID ]]; then log "scheme: \"$SCHEME_NAME\" exists (id $SCHEME_ID)"; fi
  if [[ -n $CHANNEL_ID ]]; then log "channel: Android $BUNDLE_ID exists (id $CHANNEL_ID)"; fi

  if ((DRY_RUN)); then
    [[ -n $APP_ID ]] || log "app: would create \"$APP_NAME\""
    [[ -n $SCHEME_ID ]] || log "scheme: would create \"$SCHEME_NAME\""
    [[ -n $CHANNEL_ID ]] || log "channel: would create \"$CHANNEL_NAME\" (Android, $BUNDLE_ID)"
    return 0
  fi

  if [[ -z $APP_ID ]]; then
    api POST /api/apps "${OLD_TOKEN[@]}" --data-urlencode "name=$APP_NAME"
    [[ $STATUS == 201 ]] || refused
    APP_ID="$(jq -r '.id' "$WORK/body")"
    log "app: created \"$APP_NAME\" (id $APP_ID)"
  fi
  if [[ -z $SCHEME_ID ]]; then
    api POST "/api/apps/$APP_ID/schemes" "${OLD_TOKEN[@]}" --data-urlencode "name=$SCHEME_NAME"
    [[ $STATUS == 200 || $STATUS == 201 ]] || refused
    SCHEME_ID="$(jq -r '.id' "$WORK/body")"
    log "scheme: created \"$SCHEME_NAME\" (id $SCHEME_ID)"
  fi
  if [[ -z $CHANNEL_ID ]]; then
    api POST "/api/schemes/$SCHEME_ID/channels" "${OLD_TOKEN[@]}" \
      --data-urlencode "name=$CHANNEL_NAME" --data-urlencode "device_type=android" \
      --data-urlencode "bundle_id=$BUNDLE_ID"
    [[ $STATUS == 200 || $STATUS == 201 ]] || refused
    CHANNEL_ID="$(jq -r '.id' "$WORK/body")"
    CHANNEL_KEY="$(jq -r '.key' "$WORK/body")"
    log "channel: created \"$CHANNEL_NAME\" (id $CHANNEL_ID)"
  fi
  [[ -n $CHANNEL_KEY && $CHANNEL_KEY != null ]] || die "Zealot did not return the channel's key"
}

# ---- step 4b: the per-app CI token, stored where the build job reads it ---------------------------------
NEW_TOKEN_ID=""

deliver_secret() {
  if [[ -n $GITHUB_REPO ]]; then
    gh secret set ZEALOT_APP_TOKEN --repo "$GITHUB_REPO" <"$WORK/app_token" || return 1
  fi
  if [[ -n $SECRET_OUT ]]; then
    cat "$WORK/app_token" >"$SECRET_OUT" && chmod 600 "$SECRET_OUT" || return 1
  fi
  return 0
}

step_token() {
  [[ -n $APP_ID ]] || { log "token: would be made once the app exists"; return 0; }

  api GET "/api/apps/$APP_ID/api_tokens" "${AUTH[@]}"
  [[ $STATUS == 200 ]] || refused
  local live_ids live_count
  live_ids="$(jq -r --arg n "$TOKEN_NAME" '.tokens[] | select(.name == $n and .live) | .id' "$WORK/body")"
  live_count="$(printf '%s' "$live_ids" | grep -c . || true)"

  if ((live_count > 0 && !ROTATE)); then
    log "token: a live token named \"$TOKEN_NAME\" already exists; its secret cannot be read back. Use --rotate to replace it."
    return 0
  fi
  [[ -n $GITHUB_REPO || -n $SECRET_OUT ]] || die "a new token's secret is shown once: pass --github-repo and/or --secret-out to say where it goes"
  if ((DRY_RUN)); then
    log "token: would make \"$TOKEN_NAME\" (expires: $EXPIRY)$( ((ROTATE && live_count > 0)) && printf ', then revoke %s older one(s)' "$live_count")"
    return 0
  fi

  api POST "/api/apps/$APP_ID/api_tokens" "${AUTH[@]}" \
    --data-urlencode "name=$TOKEN_NAME" --data-urlencode "expiry=$EXPIRY"
  [[ $STATUS == 201 ]] || refused
  jq -j '.secret' "$WORK/body" >"$WORK/app_token"
  NEW_TOKEN_ID="$(jq -r '.id' "$WORK/body")"
  rm -f "$WORK/body"
  [[ -s $WORK/app_token ]] || die "Zealot's answer held no token secret"

  if ! deliver_secret; then
    log "token: could not store the secret; revoking the token just made so nothing is left behind"
    api DELETE "/api/apps/$APP_ID/api_tokens/$NEW_TOKEN_ID" "${AUTH[@]}" || true
    die "the token was not stored (is gh logged in with access to $GITHUB_REPO? does the --secret-out folder exist?)"
  fi
  # Built from plain strings: an apostrophe inside a double-quoted ${VAR:+...} made bash look for a closing
  # single quote to the end of the file (unexpected EOF), found on the first run.
  local where=""
  [[ -z $GITHUB_REPO ]] || where=" as the secret ZEALOT_APP_TOKEN on $GITHUB_REPO"
  [[ -z $SECRET_OUT ]] || where="$where, and in $SECRET_OUT (mode 600)"
  log "token: made \"$TOKEN_NAME\" (id $NEW_TOKEN_ID) and stored it$where"

  if ((ROTATE)); then
    local id
    for id in $live_ids; do
      api DELETE "/api/apps/$APP_ID/api_tokens/$id" "${AUTH[@]}"
      if [[ $STATUS == 200 ]]; then log "token: revoked the older token $id"; else log "token: could not revoke the older token $id ($STATUS)"; fi
    done
  fi
}

# ---- step 4c: the two non-secret values the workflow reads ----------------------------------------------
step_variables() {
  [[ -n $GITHUB_REPO && -n $CHANNEL_KEY ]] || return 0
  if ((DRY_RUN)); then
    log "github: would set variables ZEALOT_URL and ZEALOT_CHANNEL_KEY on $GITHUB_REPO"
    return 0
  fi
  gh variable set ZEALOT_URL --repo "$GITHUB_REPO" --body "$ZEALOT_URL" || die "could not set ZEALOT_URL on $GITHUB_REPO"
  gh variable set ZEALOT_CHANNEL_KEY --repo "$GITHUB_REPO" --body "$CHANNEL_KEY" || die "could not set ZEALOT_CHANNEL_KEY on $GITHUB_REPO"
  log "github: set variables ZEALOT_URL and ZEALOT_CHANNEL_KEY on $GITHUB_REPO"
}

# ---- run -------------------------------------------------------------------------------------------------
if ((DRY_RUN)); then log "dry run: reading only, nothing will be changed"; fi

if [[ $ONLY == signing-key ]]; then
  step_signing_key
  log "done: the organisation's signing key is in place. Next, as a developer account: --only app"
  exit 0
fi

step_app_scheme_channel
step_token
step_variables

# The summary is on stdout; none of it is secret.
printf 'ZEALOT_URL=%s\n' "$ZEALOT_URL"
printf 'ZEALOT_CHANNEL_KEY=%s\n' "$CHANNEL_KEY"
printf 'app_id=%s scheme_id=%s channel_id=%s\n' "$APP_ID" "$SCHEME_ID" "$CHANNEL_ID"
if [[ -n $SECRET_OUT && -s $SECRET_OUT ]]; then
  printf 'next (leaf 16 step 6): curl -H "Authorization: Bearer $(cat %s)" -F channel_key=%s -F hold=true -F file=@storeapp.aab %s/api/apps/upload\n' \
    "$SECRET_OUT" "$CHANNEL_KEY" "$ZEALOT_URL"
fi
