#!/usr/bin/with-contenv sh

# Anthropic (handover.md task #6): mtproto-worker runs as a peer process in
# this same container, supervised by s6 like caddy/job/zealot already are —
# see the Dockerfile comment above the COPY --from=builder mtproto-worker
# lines for why this was chosen over a second Render service. It binds only
# to 127.0.0.1 (index.ts's own PORT default), so it is reachable from the
# Rails process in this container and nowhere else — no public port, no
# Render private network needed.
#
# Guarded on MTPROTO_ARCHIVE_ENABLED: the worker's own index.ts calls
# requireEnv() for TELEGRAM_API_ID/HASH/SESSION_STRING/ARCHIVE_CHAT_ID and
# MTPROTO_WORKER_SHARED_SECRET, and process.exit(1)s if any are missing.
# Under s6, a service that exits gets restarted in a tight loop forever, so
# running it unconditionally would spam the log with the same crash every
# few seconds on any deploy that hasn't set those vars yet (which is every
# deploy until an operator generates a real TELEGRAM_SESSION_STRING — see
# mtproto-worker/README.md's Setup section; still not done as of this
# session). `s6-svc -O -d` marks this service intentionally, permanently
# down rather than crash-looping, so `s6-overlay-suexec` (and `docker ps`
# health, and the s6 supervise logs) all show one clean "down by request"
# state instead of a stream of restarts.
if [ "$MTPROTO_ARCHIVE_ENABLED" != "true" ]; then
  echo "mtproto-worker: MTPROTO_ARCHIVE_ENABLED is not 'true', not starting (see mtproto-worker/README.md Setup)"
  s6-svc -O -d /var/run/s6/services/mtproto-worker
  exit 0
fi

echo "Starting mtproto-worker (Telegram MTProto cold-storage sidecar)"
cd /app/mtproto-worker
# PORT is already set container-wide (Render sets it to 80 for Caddy, which
# has it hardcoded in the Caddyfile regardless). s6 services inherit the
# full container env, so without this override the worker would inherit
# that same PORT=80 and race Caddy for the same bind — whichever of the two
# starts second fails. Pin the worker to its own port explicitly; must
# match MTPROTO_WORKER_URL on the Rails side (see
# app/services/anthropic/mtproto_archive_service.rb).
exec env PORT=8081 node dist/index.js 2>&1 | tee -a /app/log/mtproto-worker.log
